#!/usr/bin/env bash
set -euo pipefail

MAW_VERSION="0.5.0"

# symlink を解決して実体のパスを取得
MAW_SCRIPT="${BASH_SOURCE[0]}"
while [[ -L "$MAW_SCRIPT" ]]; do
  MAW_SCRIPT_DIR="$(cd "$(dirname "$MAW_SCRIPT")" && pwd)"
  MAW_SCRIPT="$(readlink "$MAW_SCRIPT")"
  [[ "$MAW_SCRIPT" != /* ]] && MAW_SCRIPT="${MAW_SCRIPT_DIR}/${MAW_SCRIPT}"
done

MAW_DIR="$(cd "$(dirname "$MAW_SCRIPT")/.." && pwd)"
LIB_DIR="${MAW_DIR}/lib"

# shellcheck source=lib/core.sh
source "${LIB_DIR}/core.sh"

# shellcheck source=lib/validate.sh
source "${LIB_DIR}/validate.sh"

usage() {
  cat <<EOF
maw - Multi-Agent Workspace manager v${MAW_VERSION}

Usage: maw <command> [options]

Commands:
  init                    プロジェクトを maw 用に初期化
  spawn <name> [options]  新しいワークスペースを作成
  list                    ワークスペース一覧を表示
  status                  ワークスペース状況と排他情報を表示
  claim <file> [options]  ファイル/ディレクトリの排他宣言
  unclaim <file> [options] 排他宣言を解除
  handover [options]      引き継ぎドキュメントを生成
  merge [name|options]    ブランチをマージ
  takeover [name]         handover bundle を読んでセッション再開プロンプトを出力
  cleanup [name|options]  ワークスペースを削除
  doctor                  環境の整合性チェック

Options:
  -h, --help              ヘルプを表示
  -v, --version           バージョンを表示

詳細: https://github.com/yyyyyyy0/maw
EOF
}

check_dependencies() {
  local missing=()

  if ! command -v git &>/dev/null; then
    missing+=("git")
  fi

  if ! command -v jq &>/dev/null; then
    missing+=("jq")
  fi

  if [[ ${#missing[@]} -gt 0 ]]; then
    log_error "必須ツールが見つかりません: ${missing[*]}"
    log_error "インストールしてください:"
    for tool in "${missing[@]}"; do
      case "$tool" in
        jq)  log_error "  macOS: brew install jq  /  Linux: apt install jq" ;;
        git) log_error "  macOS: xcode-select --install  /  Linux: apt install git" ;;
      esac
    done
    exit 1
  fi
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi

  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -v|--version)
      echo "maw v${MAW_VERSION}"
      exit 0
      ;;
    init|spawn|list|cleanup|doctor|status|claim|unclaim|handover|merge|takeover)
      check_dependencies
      local cmd="$1"
      shift
      source "${LIB_DIR}/${cmd}.sh"
      "cmd_${cmd}" "$@"
      ;;
    *)
      log_error "不明なコマンド: $1"
      usage
      exit 1
      ;;
  esac
}

main "$@"
